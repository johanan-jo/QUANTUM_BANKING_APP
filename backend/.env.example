# Database Configuration (Supabase / PostgreSQL)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.xxxxxx.supabase.co:5432/postgres

# Gmail API OAuth 2.0 Configuration (Replaces SendGrid & SMTP)
# Run `python scripts/get_refresh_token.py` to generate your refresh token
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=1//your-oauth-refresh-token
GMAIL_SENDER_EMAIL=your-authorized-sender@gmail.com

# JWT & Security Configuration
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars

# Application Settings
DEBUG_OTP=false
FLASK_ENV=production
PORT=5000
